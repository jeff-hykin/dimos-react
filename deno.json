{
    "nodeModulesDir": "none",
    "imports": {
        "react": "npm:react@19.2.0",
        "react-dom": "npm:react-dom@19.2.0",
        "react-dom/": "npm:/react-dom@19.2.0/",
        "three": "npm:three@0.180.0",
        "three/examples/jsm/": "npm:/three@0.180.0/examples/jsm/",
        "happy-dom": "npm:happy-dom@15.11.7",
        "@std/assert": "jsr:@std/assert@1",
        "@std/http/file-server": "jsr:@std/http@1/file-server"
    },
    "tasks": {
        "test": "deno test -A --no-check test/",
        "demo": "deno run -A tools/serve.js",
        "sync-tokens": "deno run -A tools/sync_tokens.js",
        "vendor": "deno run -A tools/vendor.js"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "exclude": [
            "src/vendor/",
            "src/theme/tokens.js"
        ]
    },
    "lint": {
        "exclude": [
            "src/vendor/"
        ],
        "rules": {
            "exclude": [
                "no-window",
                "no-window-prefix",
                "require-await"
            ]
        }
    }
}
