{
    "name": "dimos-react",
    "version": "0.1.13",
    "description": "React UI toolkit for dimOS Desktop apps: themed components, Desktop theme inheritance, URL state, zenoh hooks and a three.js 3D view",
    "type": "module",
    "main": "mod.js",
    "module": "mod.js",
    "exports": {
        ".": {
            "types": "./mod.d.ts",
            "default": "./mod.js"
        },
        "./three": {
            "types": "./three.d.ts",
            "default": "./three.js"
        },
        "./*": "./*"
    },
    "license": "MIT",
    "repository": "github:jeff-hykin/dimos-react",
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "three": ">=0.160"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    },
    "types": "mod.d.ts"
}
